# Chep thanh .env truoc khi chay: cp .env.example .env
# .env KHONG duoc commit (da nam trong .gitignore).

# Mat khau root cua ca ba container MySQL.
DB_PASSWORD=doi-mat-khau-nay

# Phai giong het o ca ba service backend. De trong thi moi service dung mac dinh
# trong application.properties — van chay duoc nhung khong nen dung that.
JWT_SECRET=Bloom-Studio-Secret-Key-Do-An-Huong-Dich-Vu-2026-Doi-Trong-Thuc-Te

# So giay Gateway nho ket qua kiem tra API Key. Dat 0 khi can trinh bay canh
# thu hoi khoa co hieu luc ngay.
PARTNER_KEY_CACHE_TTL=60

# ---------- Dang nhap bang Google ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost va http://localhost:5173
# Chi can Client ID (khong can client secret). De trong: nut Google tren trang dang nhap tu an.
GOOGLE_CLIENT_ID=

# ---------- Giao Hang Nhanh (GHN) ----------
# Dang ky moi truong thu nghiem tai https://5sao.ghn.dev -> Chu cua hang -> Token API,
# va ShopId cua cua hang da tao. De trong: dia chi go tu do, phi giao hang co dinh 30.000d.
GHN_TOKEN=
GHN_SHOP_ID=

# ---------- Thanh toan truc tuyen ----------
# Cong nao de trong thi an khoi trang thanh toan. KHONG commit khoa that.
# VNPay sandbox: dang ky tai https://sandbox.vnpayment.vn/devreg/ (email gui kem TmnCode + HashSecret)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# MoMo: khoa thu nghiem cong khai trong tai lieu MoMo (developers.momo.vn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# ZaloPay: ung dung thu nghiem trong tai lieu ZaloPay (docs.zalopay.vn), vi du app_id 2553
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# Trang frontend ma cong thanh toan dua khach ve, va dia chi cong khai cho IPN.
# Muon nhan IPN khi chay tren may ca nhan thi mo tunnel (ngrok, cloudflared) toi cong 8080
# roi dat PAYMENT_PUBLIC_BASE_URL bang dia chi tunnel.
# ZaloPay chi dua khach ve dia chi https:// - muon thu ZaloPay thi chay customer-frontend
# bang `npm run dev:https` va doi dong duoi thanh https://localhost:5173/payment/result
PAYMENT_RETURN_URL=http://localhost:5173/payment/result
PAYMENT_PUBLIC_BASE_URL=http://localhost:8080

# ---------- Thong bao ----------
# Hop thu cua hang nhan email "don moi", "da thanh toan", "can hoan tien".
# Docker gui toi Mailpit (xem thu tai http://localhost:8025), khong ra Internet.
NOTIFICATION_SHOP_EMAIL=shop@bloomstudio.local
# Gui thu THAT qua Gmail: bo dau # o 7 dong duoi. MAIL_PASSWORD la App Password 16 ky tu
# (Tai khoan Google -> Bao mat -> Xac minh 2 buoc -> Mat khau ung dung), KHONG phai mat khau Gmail.
# Gmail ghi de dia chi nguoi gui bang chinh MAIL_USERNAME. KHONG commit mat khau that.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=ban@gmail.com
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# NOTIFICATION_FROM=Bloom Studio <ban@gmail.com>

# ---------- Claude API (tro ly AI trong khung chat) ----------
# Lay khoa tai https://console.anthropic.com -> API Keys. KHONG commit khoa that.
# De trong: chi dung bot kich ban mien phi (goi y hoa, gio giao, don hang), khong co Claude.
ANTHROPIC_API_KEY=
# Mac dinh claude-opus-5-5. Muon re hon: claude-sonnet-5-5 hoac claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5-5
